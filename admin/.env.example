# Configurar apenas no servidor; nunca usar prefixo NEXT_PUBLIC_.
EDITORIAL_ORIGIN=http://localhost:4180
# Caminho absoluto do checkout persistente do SilfonTech no servidor.
EDITORIAL_ROOT=
# E-mails Google autorizados, separados por vírgula. Vazio bloqueia o login.
EDITORIAL_ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini: usar somente chave de projeto no nível Free, sem faturamento ativo.
# A integração fica indisponível até configurar a chave no servidor.
EDITORIAL_AI_ENABLED=true
# Chave privada do Google AI Studio; nunca enviar ao chat ou usar NEXT_PUBLIC_.
GEMINI_API_KEY=

# Icecat Product JSON: token privado em header; não use NEXT_PUBLIC_
ICECAT_ENABLED=false
ICECAT_API_TOKEN=

# Um lote diário enquanto o servidor editorial estiver ativo
ICECAT_AUTO_SYNC=false

# Catálogo Mercado Livre e importação por link gerado no painel de afiliados.
# Token OAuth da conta; não confundir com Client ID/Secret ou com Mercado Pago.
RETAILER_IMPORT_ENABLED=true
MERCADOLIVRE_ACCESS_TOKEN=
# Configuração opcional da Amazon.
AMAZON_CREATOR_CLIENT_ID=
AMAZON_CREATOR_CLIENT_SECRET=
AMAZON_PARTNER_TAG=

# Conexão OAuth com Mercado Livre (aliases atuais aceitos).
ML_ID_APP=
ML_SECRET_KEY=
# Opcional: mesma origem do painel, rota /auth/mercadolivre/callback.
MERCADOLIVRE_REDIRECT_URI=
# Alternativa: MERCADOLIVRE_CLIENT_ID / MERCADOLIVRE_CLIENT_SECRET.
# Sem token manual, conecte a conta pelo painel. Tokens ficam em .editorial-admin/.
