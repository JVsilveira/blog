# Site público: só preencher com a origem HTTPS real, sem caminho.
NEXT_PUBLIC_SITE_URL=
# Manter false em local/preview. true apenas no build destinado ao lançamento.
NEXT_PUBLIC_SITE_INDEXING=false
# Rotas estáticas revisadas, separadas por vírgula. Artigos aprovados entram automaticamente.
# Exemplo de rotas (adicionar somente após revisão): /,/ajuda/,/sobre/,/metodologia/
NEXT_PUBLIC_SEO_APPROVED_PATHS=
# Tokens de verificação de propriedade, fornecidos pelos respectivos consoles.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# A configuração privada do painel fica em admin/.env.local, conforme seu próprio exemplo.

# Opcional: token de conteúdo privado para baixar imagens liberadas pelo Icecat.
ICECAT_CONTENT_TOKEN=

# Importação por link: manter desativada até configurar as contas oficiais.
RETAILER_IMPORT_ENABLED=false
AMAZON_CREATOR_CLIENT_ID=
AMAZON_CREATOR_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
MERCADOLIVRE_ACCESS_TOKEN=
